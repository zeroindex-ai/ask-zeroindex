# Anthropic — answer generation (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=

# Voyage AI — embeddings (voyage-3) + reranking (rerank-2.5)
# Sign up: https://www.voyageai.com/
VOYAGE_API_KEY=

# Turso (libsql) — vector + FTS store
# Create DB: turso db create ask-zeroindex
# Get URL:   turso db show ask-zeroindex --url
# Get token: turso db tokens create ask-zeroindex
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Comma-separated list of origins allowed to POST /api/ask.
# Empty = allow all (dev default). Production should pin to the embed host:
#   ALLOWED_ORIGINS=https://zeroindex.ai
# Include "null" if loading the widget via file:// (e.g. preview HTML):
#   ALLOWED_ORIGINS=http://localhost:3000,null
ALLOWED_ORIGINS=

# Target origin for postMessage from the /embed iframe to its parent.
# Empty / unset = "*" (dev default). Production should pin to the host:
#   NEXT_PUBLIC_PARENT_ORIGIN=https://zeroindex.ai
NEXT_PUBLIC_PARENT_ORIGIN=
